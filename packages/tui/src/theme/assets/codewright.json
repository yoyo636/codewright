{
  "$schema": "https://codewright.dev/theme.json",
  "defs": {
    "ink": "#07070a",
    "ink-2": "#0b0b12",
    "ink-3": "#10101a",
    "ink-4": "#161622",
    "ink-5": "#1d1d2b",
    "ink-6": "#262638",
    "ink-7": "#313148",
    "ink-8": "#41415e",
    "ink-9": "#5a5a78",
    "ink-10": "#777794",
    "ink-11": "#9a9ab0",
    "ink-12": "#e6e6ee",
    "aurora": "#8b7cff",
    "aurora-2": "#5eead4",
    "aurora-3": "#c4b5fd",
    "ember": "#f59e0b",
    "emerald": "#34d399",
    "rose": "#f87171",
    "sky": "#60a5fa",
    "surface": "rgba(16, 16, 26, 0.72)",
    "surface-strong": "rgba(22, 22, 34, 0.82)",
    "surface-border": "rgba(255, 255, 255, 0.07)",
    "surface-border-active": "rgba(255, 255, 255, 0.14)",
    "lightInk": "#0a0a12",
    "lightInk-2": "#14141f",
    "lightInk-3": "#1e1e2e",
    "lightInk-4": "#2a2a3e",
    "lightInk-5": "#37374d",
    "lightInk-6": "#4a4a63",
    "lightInk-7": "#63637d",
    "lightInk-8": "#8282a0",
    "lightInk-9": "#a5a5c2",
    "lightInk-10": "#c5c5d6",
    "lightInk-11": "#dcdce6",
    "lightInk-12": "#f4f4f8",
    "lightAurora": "#6d5ef0",
    "lightAurora-2": "#0d9488",
    "lightSurface": "rgba(255, 255, 255, 0.72)",
    "lightSurface-strong": "rgba(255, 255, 255, 0.88)",
    "lightSurface-border": "rgba(20, 20, 32, 0.08)",
    "lightSurface-border-active": "rgba(20, 20, 32, 0.16)"
  },
  "theme": {
    "primary": { "dark": "aurora", "light": "lightAurora" },
    "secondary": { "dark": "aurora-3", "light": "lightInk-9" },
    "accent": { "dark": "aurora-2", "light": "lightAurora-2" },
    "error": { "dark": "rose", "light": "rose" },
    "warning": { "dark": "ember", "light": "ember" },
    "success": { "dark": "emerald", "light": "emerald" },
    "info": { "dark": "sky", "light": "sky" },
    "text": { "dark": "ink-12", "light": "lightInk-12" },
    "textMuted": { "dark": "ink-10", "light": "lightInk-9" },
    "background": { "dark": "ink", "light": "lightInk" },
    "backgroundPanel": { "dark": "surface", "light": "lightSurface" },
    "backgroundElement": { "dark": "surface-strong", "light": "lightSurface-strong" },
    "backgroundMenu": { "dark": "surface-strong", "light": "lightSurface-strong" },
    "border": { "dark": "surface-border", "light": "lightSurface-border" },
    "borderActive": { "dark": "surface-border-active", "light": "lightSurface-border-active" },
    "borderSubtle": { "dark": "ink-4", "light": "lightInk-3" },
    "diffAdded": { "dark": "emerald", "light": "emerald" },
    "diffRemoved": { "dark": "rose", "light": "rose" },
    "diffContext": { "dark": "ink-9", "light": "lightInk-8" },
    "diffHunkHeader": { "dark": "aurora-3", "light": "lightAurora" },
    "diffHighlightAdded": { "dark": "aurora-2", "light": "lightAurora-2" },
    "diffHighlightRemoved": { "dark": "ember", "light": "ember" },
    "diffAddedBg": { "dark": "rgba(52, 211, 153, 0.10)", "light": "rgba(52, 211, 153, 0.14)" },
    "diffRemovedBg": { "dark": "rgba(248, 113, 113, 0.10)", "light": "rgba(248, 113, 113, 0.14)" },
    "diffContextBg": { "dark": "surface", "light": "lightSurface" },
    "diffLineNumber": { "dark": "ink-8", "light": "lightInk-7" },
    "diffAddedLineNumberBg": { "dark": "rgba(52, 211, 153, 0.08)", "light": "rgba(52, 211, 153, 0.12)" },
    "diffRemovedLineNumberBg": { "dark": "rgba(248, 113, 113, 0.08)", "light": "rgba(248, 113, 113, 0.12)" },
    "markdownText": { "dark": "ink-12", "light": "lightInk-12" },
    "markdownHeading": { "dark": "ink-12", "light": "lightInk-12" },
    "markdownLink": { "dark": "aurora", "light": "lightAurora" },
    "markdownLinkText": { "dark": "aurora-2", "light": "lightAurora-2" },
    "markdownCode": { "dark": "aurora-2", "light": "lightAurora-2" },
    "markdownBlockQuote": { "dark": "ink-9", "light": "lightInk-8" },
    "markdownEmph": { "dark": "aurora-3", "light": "lightAurora" },
    "markdownStrong": { "dark": "ink-12", "light": "lightInk-12" },
    "markdownHorizontalRule": { "dark": "ink-5", "light": "lightInk-4" },
    "markdownListItem": { "dark": "aurora", "light": "lightAurora" },
    "markdownListEnumeration": { "dark": "aurora-2", "light": "lightAurora-2" },
    "markdownImage": { "dark": "aurora", "light": "lightAurora" },
    "markdownImageText": { "dark": "aurora-3", "light": "lightAurora" },
    "markdownCodeBlock": { "dark": "ink-12", "light": "lightInk-12" },
    "syntaxComment": { "dark": "ink-9", "light": "lightInk-8" },
    "syntaxKeyword": { "dark": "aurora-3", "light": "lightAurora" },
    "syntaxFunction": { "dark": "aurora", "light": "lightAurora" },
    "syntaxVariable": { "dark": "ink-12", "light": "lightInk-12" },
    "syntaxString": { "dark": "emerald", "light": "emerald" },
    "syntaxNumber": { "dark": "ember", "light": "ember" },
    "syntaxType": { "dark": "aurora-2", "light": "lightAurora-2" },
    "syntaxOperator": { "dark": "ink-10", "light": "lightInk-9" },
    "syntaxPunctuation": { "dark": "ink-11", "light": "lightInk-10" },
    "selectedListItemText": { "dark": "aurora", "light": "lightAurora" },
    "thinkingOpacity": 0.55
  }
}