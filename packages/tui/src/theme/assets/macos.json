{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#1c1c1e",
    "darkBgPanel": "#2c2c2e",
    "darkBgElement": "#3a3a3c",
    "darkText": "#f5f5f7",
    "darkTextMuted": "#98989d",
    "darkBlue": "#0a84ff",
    "darkPurple": "#bf5af2",
    "darkIndigo": "#5e5ce6",
    "darkTeal": "#64d2ff",
    "darkGreen": "#30d158",
    "darkOrange": "#ff9f0a",
    "darkRed": "#ff453a",
    "darkYellow": "#ffd60a",
    "darkPink": "#fc5fa3",
    "lightBg": "#ffffff",
    "lightBgPanel": "#f5f5f7",
    "lightBgElement": "#e8e8ed",
    "lightText": "#1d1d1f",
    "lightTextMuted": "#6e6e73",
    "lightBlue": "#007aff",
    "lightPurple": "#af52de",
    "lightIndigo": "#5856d6",
    "lightTeal": "#5ac8fa",
    "lightGreen": "#248a3d",
    "lightOrange": "#c93400",
    "lightRed": "#d70015",
    "lightYellow": "#9e7c00",
    "lightPink": "#ad3da4"
  },
  "theme": {
    "primary": {
      "dark": "darkBlue",
      "light": "lightBlue"
    },
    "secondary": {
      "dark": "darkPurple",
      "light": "lightPurple"
    },
    "accent": {
      "dark": "darkTeal",
      "light": "lightIndigo"
    },
    "error": {
      "dark": "darkRed",
      "light": "lightRed"
    },
    "warning": {
      "dark": "darkOrange",
      "light": "lightOrange"
    },
    "success": {
      "dark": "darkGreen",
      "light": "lightGreen"
    },
    "info": {
      "dark": "darkIndigo",
      "light": "lightBlue"
    },
    "text": {
      "dark": "darkText",
      "light": "lightText"
    },
    "textMuted": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "selectedListItemText": {
      "dark": "#ffffff",
      "light": "#ffffff"
    },
    "background": {
      "dark": "darkBg",
      "light": "lightBg"
    },
    "backgroundPanel": {
      "dark": "darkBgPanel",
      "light": "lightBgPanel"
    },
    "backgroundElement": {
      "dark": "darkBgElement",
      "light": "lightBgElement"
    },
    "backgroundMenu": {
      "dark": "darkBgPanel",
      "light": "lightBgPanel"
    },
    "border": {
      "dark": "darkBgElement",
      "light": "#d2d2d7"
    },
    "borderActive": {
      "dark": "darkBlue",
      "light": "lightBlue"
    },
    "borderSubtle": {
      "dark": "darkBgPanel",
      "light": "lightBgElement"
    },
    "diffAdded": {
      "dark": "darkGreen",
      "light": "#1e7b34"
    },
    "diffRemoved": {
      "dark": "darkRed",
      "light": "lightRed"
    },
    "diffContext": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "diffHunkHeader": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "diffHighlightAdded": {
      "dark": "#63d98b",
      "light": "#28a745"
    },
    "diffHighlightRemoved": {
      "dark": "#ff6961",
      "light": "#ff3b30"
    },
    "diffAddedBg": {
      "dark": "#1e3a2f",
      "light": "#e2f5e9"
    },
    "diffRemovedBg": {
      "dark": "#3a2226",
      "light": "#fce8e6"
    },
    "diffContextBg": {
      "dark": "darkBgPanel",
      "light": "lightBgPanel"
    },
    "diffLineNumber": {
      "dark": "#636366",
      "light": "#8e8e93"
    },
    "diffAddedLineNumberBg": {
      "dark": "#183028",
      "light": "#d3eedd"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#301c20",
      "light": "#f5d5d3"
    },
    "markdownText": {
      "dark": "darkText",
      "light": "lightText"
    },
    "markdownHeading": {
      "dark": "darkBlue",
      "light": "lightBlue"
    },
    "markdownLink": {
      "dark": "darkTeal",
      "light": "lightBlue"
    },
    "markdownLinkText": {
      "dark": "darkTeal",
      "light": "lightIndigo"
    },
    "markdownCode": {
      "dark": "darkGreen",
      "light": "lightGreen"
    },
    "markdownBlockQuote": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "markdownEmph": {
      "dark": "darkYellow",
      "light": "lightYellow"
    },
    "markdownStrong": {
      "dark": "#ffffff",
      "light": "#000000"
    },
    "markdownHorizontalRule": {
      "dark": "darkBgElement",
      "light": "#d2d2d7"
    },
    "markdownListItem": {
      "dark": "darkBlue",
      "light": "lightBlue"
    },
    "markdownListEnumeration": {
      "dark": "darkTeal",
      "light": "lightIndigo"
    },
    "markdownImage": {
      "dark": "darkPurple",
      "light": "lightPurple"
    },
    "markdownImageText": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "markdownCodeBlock": {
      "dark": "darkText",
      "light": "lightText"
    },
    "syntaxComment": {
      "dark": "#7f8c98",
      "light": "#707f8c"
    },
    "syntaxKeyword": {
      "dark": "darkPink",
      "light": "lightPink"
    },
    "syntaxFunction": {
      "dark": "#67b7a4",
      "light": "#326d74"
    },
    "syntaxVariable": {
      "dark": "darkText",
      "light": "lightText"
    },
    "syntaxString": {
      "dark": "#fc6a5d",
      "light": "#c41a16"
    },
    "syntaxNumber": {
      "dark": "#d9c97c",
      "light": "#1c00cf"
    },
    "syntaxType": {
      "dark": "#d0a8ff",
      "light": "#6f36a9"
    },
    "syntaxOperator": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    },
    "syntaxPunctuation": {
      "dark": "darkTextMuted",
      "light": "lightTextMuted"
    }
  }
}
